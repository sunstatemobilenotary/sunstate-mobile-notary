---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import matter from 'gray-matter';

// Read all FAQ markdown files
const faqDir = join(process.cwd(), 'src/content/faq');
const faqFiles = await readdir(faqDir);

const faqs = await Promise.all(
  faqFiles
    .filter(file => file.endsWith('.md'))
    .map(async (file) => {
      const content = await readFile(join(faqDir, file), 'utf-8');
      const { data, content: body } = matter(content);
      return {
        slug: file.replace('.md', ''),
        question: data.question,
        category: data.category || 'General',
        order: data.order || 999,
        body
      };
    })
);

// Sort by order
faqs.sort((a, b) => a.order - b.order);

// Group by category
const categories = [...new Set(faqs.map(faq => faq.category))];
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Common questions about mobile notary services, pricing, scheduling, and requirements in Florida."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
      <p class="text-xl text-primary-100">Quick answers to common questions</p>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-4xl mx-auto">
      <!-- Category Navigation -->
      {categories.length > 1 && (
        <div class="mb-12 flex flex-wrap gap-3 justify-center">
          {categories.map((category) => (
            <a
              href={`#${category.toLowerCase().replace(/\s+/g, '-')}`}
              class="px-4 py-2 bg-primary-100 text-primary-700 rounded-lg hover:bg-primary-200 transition font-medium"
            >
              {category}
            </a>
          ))}
        </div>
      )}

      <!-- FAQ Items -->
      <div class="space-y-12">
        {categories.map((category) => {
          const categoryFaqs = faqs.filter(faq => faq.category === category);
          return (
            <div id={category.toLowerCase().replace(/\s+/g, '-')}>
              {categories.length > 1 && (
                <h2 class="text-2xl font-bold text-primary-700 mb-6 pb-2 border-b-2 border-primary-200">
                  {category}
                </h2>
              )}
              <div class="space-y-6">
                {categoryFaqs.map((faq) => (
                  <div class="card">
                    <h3 class="text-xl font-bold text-gray-900 mb-3">
                      {faq.question}
                    </h3>
                    <div class="prose prose-gray max-w-none text-gray-700" set:html={faq.body} />
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Still Have Questions -->
      <div class="mt-12 p-8 bg-primary-50 border-l-4 border-primary-600 rounded">
        <h3 class="text-xl font-bold text-primary-900 mb-3">Still Have Questions?</h3>
        <p class="text-gray-700 mb-4">
          If you didn't find the answer you're looking for, we're happy to help. Contact us directly and we'll provide the information you need.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/book" class="btn-primary inline-block text-center">Contact Us</a>
          <a href="/services" class="btn-secondary inline-block text-center">View Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Schedule Your Appointment?</h2>
      <p class="text-lg text-gray-600 mb-8">
        Book online or contact us for same-day mobile notary service.
      </p>
      <a href="/book" class="btn-primary inline-block">Book Now</a>
    </div>
  </section>
</BaseLayout>
