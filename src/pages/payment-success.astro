---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Payment Successful"
  description="Your payment has been processed successfully."
>
  <section class="section bg-white min-h-screen flex items-center justify-center">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full">
          <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4">Payment Successful!</h1>
      <p class="text-xl text-gray-600 mb-8">
        Thank you for your payment. We've received your deposit and your appointment is confirmed.
      </p>

      <div class="bg-primary-50 rounded-lg p-6 mb-8 border-l-4 border-primary-600">
        <h2 class="text-lg font-bold text-gray-900 mb-3">What's Next?</h2>
        <ul class="text-left space-y-2 text-gray-700">
          <li>✓ You'll receive a confirmation email shortly</li>
          <li>✓ We'll send you a reminder before your appointment</li>
          <li>✓ If you have questions, contact us anytime</li>
        </ul>
      </div>

      <div class="space-y-4">
        <p class="text-gray-700">
          <strong>Need to make changes to your appointment?</strong><br>
          Contact us at <a href="mailto:rich@sunstatemobilenotary.com" class="text-primary-600 hover:text-primary-800">rich@sunstatemobilenotary.com</a>
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href="/" class="btn-primary">Return to Home</a>
          <a href="/services" class="btn-secondary">View Services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
