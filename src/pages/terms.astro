---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const terms = await getEntry('legal', 'terms');
const { Content } = await terms.render();
---

<BaseLayout
  title="Terms of Service"
  description="Terms of Service for Sunstate Mobile Notary - conditions for using our services."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Terms of Service</h1>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">Questions About Our Terms?</h2>
      <p class="text-lg text-gray-600 mb-6">
        Contact us if you need clarification on any of our terms of service.
      </p>
      <a href="/book" class="btn-primary inline-block">Contact Us</a>
    </div>
  </section>
</BaseLayout>
