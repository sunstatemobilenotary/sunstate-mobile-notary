---
import BaseLayout from '../layouts/BaseLayout.astro';
import businessInfo from '../content/business-info.json';
---

<BaseLayout
  title="Service Area"
  description="Mobile notary services throughout Florida. We travel to you for convenient, professional notarization."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Service Area</h1>
      <p class="text-xl text-primary-100">Proudly serving Florida communities</p>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-4xl mx-auto">
      <!-- Primary Service Area -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Primary Service Area</h2>
        <div class="card bg-primary-50 border-l-4 border-primary-600">
          <div class="space-y-4">
            <div>
              <h3 class="font-bold text-lg text-gray-900 mb-2">Counties Served</h3>
              <p class="text-gray-700">{businessInfo.serviceArea.counties}</p>
            </div>
            <div>
              <h3 class="font-bold text-lg text-gray-900 mb-2">Major Cities</h3>
              <p class="text-gray-700">{businessInfo.serviceArea.cities}</p>
            </div>
            <div>
              <h3 class="font-bold text-lg text-gray-900 mb-2">Service Radius</h3>
              <p class="text-gray-700">{businessInfo.serviceArea.radius}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- We Travel to You -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">We Come to You</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="card">
            <h3 class="text-xl font-bold text-primary-700 mb-3">Residential</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Private homes and apartments</li>
              <li>• Retirement communities</li>
              <li>• Assisted living facilities</li>
              <li>• Nursing homes</li>
            </ul>
          </div>
          <div class="card">
            <h3 class="text-xl font-bold text-primary-700 mb-3">Commercial</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Business offices</li>
              <li>• Real estate offices</li>
              <li>• Attorney offices</li>
              <li>• Title companies</li>
            </ul>
          </div>
          <div class="card">
            <h3 class="text-xl font-bold text-primary-700 mb-3">Healthcare</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Hospitals</li>
              <li>• Medical offices</li>
              <li>• Rehabilitation centers</li>
              <li>• Hospice care facilities</li>
            </ul>
          </div>
          <div class="card">
            <h3 class="text-xl font-bold text-primary-700 mb-3">Other Locations</h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Coffee shops</li>
              <li>• Libraries</li>
              <li>• Public meeting spaces</li>
              <li>• Any convenient location</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Outside Service Area -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Outside Our Primary Area?</h2>
        <div class="card bg-accent-50 border-l-4 border-accent-500">
          <p class="text-gray-700 mb-4">
            We're often able to accommodate requests outside our primary service area. Additional travel fees may apply based on distance and time required.
          </p>
          <p class="text-gray-700 mb-4">
            <strong>Contact us to confirm service availability for your location.</strong>
          </p>
          <a href="/book" class="btn-primary inline-block">Request Service</a>
        </div>
      </div>

      <!-- Emergency Services -->
      <div class="bg-gray-100 rounded-lg p-6 border-l-4 border-gray-400">
        <h3 class="font-bold text-lg mb-3">Emergency & After-Hours Service</h3>
        <p class="text-gray-700 mb-3">
          We understand that notarization needs can be urgent. We offer:
        </p>
        <ul class="space-y-2 text-gray-700 mb-4">
          <li>• Same-day appointments (subject to availability)</li>
          <li>• Evening and weekend service</li>
          <li>• 24/7 emergency notary (by special arrangement)</li>
          <li>• Hospital and hospice visits prioritized</li>
        </ul>
        <p class="text-sm text-gray-600 italic">
          Additional fees apply for after-hours and emergency services. Contact us immediately for urgent needs.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-primary-700 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Schedule Your Mobile Notary Visit</h2>
      <p class="text-xl mb-8">We'll come to your location at a time that works for you.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book" class="bg-white text-primary-700 px-8 py-4 rounded-lg font-bold text-lg hover:bg-primary-50 transition">
          Book Now
        </a>
        <a href={`mailto:${businessInfo.email}`} class="bg-primary-800 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-primary-900 transition border-2 border-white">
          Email Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
