---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const privacy = await getEntry('legal', 'privacy');
const { Content } = await privacy.render();
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for Sunstate Mobile Notary - how we collect, use, and protect your personal information."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Privacy Policy</h1>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">Questions About Our Privacy Policy?</h2>
      <p class="text-lg text-gray-600 mb-6">
        Contact us if you have any concerns or questions about how we handle your information.
      </p>
      <a href="tel:904-234-2263" class="btn-primary inline-block">Contact Us</a>
    </div>
  </section>
</BaseLayout>
