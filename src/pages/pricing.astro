---
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json';
---

<BaseLayout
  title="Pricing"
  description="Transparent pricing for mobile notary services. Florida statutory fees plus travel."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Pricing</h1>
      <p class="text-xl text-primary-100">Transparent, fair pricing for all notary services</p>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-4xl mx-auto">
      <!-- Services Pricing -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Service Rates</h2>
        <div class="space-y-4">
          {pricingData.services.map((service) => (
            <div class="card border-l-4 border-primary-600">
              <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-2">
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900">{service.name}</h3>
                  <p class="text-gray-600 mt-1">{service.description}</p>
                  {service.notes && (
                    <p class="text-sm text-gray-500 mt-2 italic">{service.notes}</p>
                  )}
                </div>
                <div class="text-2xl font-bold text-primary-700 md:text-right whitespace-nowrap">
                  {service.price}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Travel Fees -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Travel Fees</h2>
        <div class="card bg-primary-50">
          <div class="space-y-3">
            <p class="text-gray-700">
              <strong>Base Service Area:</strong> {pricingData.travelFees.baseRadius}
            </p>
            <p class="text-gray-700">
              <strong>Additional Mileage:</strong> {pricingData.travelFees.perMile}
            </p>
            <p class="text-sm text-gray-600 italic mt-4">
              {pricingData.travelFees.notes}
            </p>
          </div>
        </div>
      </div>

      <!-- Payment Methods -->
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-gray-900">Payment Methods</h2>
        <div class="card">
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {pricingData.paymentMethods.map((method) => (
              <li class="flex items-center gap-2">
                <span class="text-primary-600">✓</span>
                <span>{method}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Deposits -->
      {pricingData.deposits.required && (
        <div class="mb-12">
          <h2 class="text-3xl font-bold mb-6 text-gray-900">Appointment Deposits</h2>
          <div class="card bg-accent-50 border-l-4 border-accent-500">
            <p class="text-gray-700 mb-2">
              <strong>Deposit Amount:</strong> {pricingData.deposits.amount}
            </p>
            <p class="text-gray-700 mb-2">
              <strong>Refundable:</strong> {pricingData.deposits.refundable ? 'Yes' : 'No'}
            </p>
            <p class="text-sm text-gray-600 italic mt-4">
              {pricingData.deposits.notes}
            </p>
          </div>
        </div>
      )}

      <!-- Important Notes -->
      <div class="bg-gray-100 rounded-lg p-6 border-l-4 border-gray-400">
        <h3 class="font-bold text-lg mb-3">Important Information</h3>
        <ul class="space-y-2 text-gray-700">
          <li>• Notary fees are set by Florida state law (maximum per signature)</li>
          <li>• Travel fees compensate for time and mileage to your location</li>
          <li>• All prices are subject to change based on service complexity and location</li>
          <li>• Contact us for exact quotes based on your specific needs</li>
          <li>• Same-day and emergency services may incur additional fees</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-primary-700 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Book?</h2>
      <p class="text-xl mb-8">Get started with professional mobile notary service today.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book" class="bg-white text-primary-700 px-8 py-4 rounded-lg font-bold text-lg hover:bg-primary-50 transition">
          Book Appointment
        </a>
        <a href="/faq" class="bg-primary-800 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-primary-900 transition border-2 border-white">
          View FAQ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
