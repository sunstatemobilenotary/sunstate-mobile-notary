---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import matter from 'gray-matter';

// Read all service markdown files
const servicesDir = join(process.cwd(), 'src/content/services');
const serviceFiles = await readdir(servicesDir);

const services = await Promise.all(
  serviceFiles
    .filter(file => file.endsWith('.md'))
    .map(async (file) => {
      const content = await readFile(join(servicesDir, file), 'utf-8');
      const { data, content: body } = matter(content);
      return {
        slug: file.replace('.md', ''),
        ...data,
        body
      };
    })
);

// Sort by order
services.sort((a, b) => (a.order || 999) - (b.order || 999));
---

<BaseLayout
  title="Services"
  description="Professional notary services including general notarization, mobile notary, loan signing, and remote online notarization."
>
  <div class="bg-primary-700 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
      <p class="text-xl text-primary-100">Professional notary services tailored to your needs</p>
    </div>
  </div>

  <section class="section bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="space-y-12">
        {services.map((service) => (
          <div id={service.slug} class="card">
            <h2 class="text-2xl md:text-3xl font-bold text-primary-700 mb-4">
              {service.title}
            </h2>
            <div class="prose prose-lg max-w-none text-gray-700" set:html={service.body} />
          </div>
        ))}
      </div>

      <div class="mt-12 p-8 bg-primary-50 border-l-4 border-primary-600 rounded">
        <h3 class="text-xl font-bold text-primary-900 mb-3">Need Something Else?</h3>
        <p class="text-gray-700 mb-4">
          If you don't see the service you need listed here, please contact us. We handle a wide variety of notarization needs and can likely assist you.
        </p>
        <a href="/book" class="btn-primary inline-block">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Schedule?</h2>
      <p class="text-lg text-gray-600 mb-8">
        Book your appointment online or contact us for same-day service.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book" class="btn-primary">Book Appointment</a>
        <a href="/pricing" class="btn-secondary">View Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Smooth scroll to service if hash is present
  if (window.location.hash) {
    const element = document.querySelector(window.location.hash);
    if (element) {
      setTimeout(() => {
        element.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
  }
</script>
