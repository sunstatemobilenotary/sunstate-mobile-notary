---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Professional mobile notary services throughout Florida. We come to you for all your notarization needs.', image = '/images/og-image.jpg' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import businessInfo from '../data/business-info.json';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href={canonicalURL}>

  <title>{title} | Sunstate Mobile Notary</title>
  <meta name="description" content={description}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={new URL(image, Astro.site)}>

  <!-- Local Business Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": businessInfo.name,
    "description": businessInfo.description,
    "url": Astro.site,
    "telephone": businessInfo.phone,
    "email": businessInfo.email,
    "address": {
      "@type": "PostalAddress",
      "addressRegion": businessInfo.serviceArea.state,
      "addressCountry": "US"
    },
    "areaServed": {
      "@type": "State",
      "name": businessInfo.serviceArea.state
    },
    "priceRange": "$$",
    "openingHours": "Mo-Su 00:00-23:59"
  })} />
</head>
<body class="flex flex-col min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-primary-700">
          {businessInfo.name}
        </a>
        <div class="hidden md:flex space-x-8">
          <a href="/" class="text-gray-700 hover:text-primary-600 transition">Home</a>
          <a href="/services" class="text-gray-700 hover:text-primary-600 transition">Services</a>
          <a href="/pricing" class="text-gray-700 hover:text-primary-600 transition">Pricing</a>
          <a href="/service-area" class="text-gray-700 hover:text-primary-600 transition">Service Area</a>
          <a href="/about" class="text-gray-700 hover:text-primary-600 transition">About</a>
          <a href="/faq" class="text-gray-700 hover:text-primary-600 transition">FAQ</a>
          <a href="/book" class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 transition">Book Now</a>
        </div>
        <button id="mobile-menu-button" class="md:hidden text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden md:hidden mt-4 space-y-2">
        <a href="/" class="block text-gray-700 hover:text-primary-600 py-2">Home</a>
        <a href="/services" class="block text-gray-700 hover:text-primary-600 py-2">Services</a>
        <a href="/pricing" class="block text-gray-700 hover:text-primary-600 py-2">Pricing</a>
        <a href="/service-area" class="block text-gray-700 hover:text-primary-600 py-2">Service Area</a>
        <a href="/about" class="block text-gray-700 hover:text-primary-600 py-2">About</a>
        <a href="/faq" class="block text-gray-700 hover:text-primary-600 py-2">FAQ</a>
        <a href="/book" class="block bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 text-center">Book Now</a>
      </div>
    </nav>
  </header>

  <main class="flex-grow">
    <slot />
  </main>

  <footer class="bg-gray-900 text-gray-300 mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h3 class="text-white text-lg font-bold mb-4">{businessInfo.name}</h3>
          <p class="text-sm">{businessInfo.description}</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/services" class="hover:text-white transition">Services</a></li>
            <li><a href="/pricing" class="hover:text-white transition">Pricing</a></li>
            <li><a href="/service-area" class="hover:text-white transition">Service Area</a></li>
            <li><a href="/faq" class="hover:text-white transition">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Contact</h4>
          <ul class="space-y-2 text-sm">
            <li>Email: <a href={`mailto:${businessInfo.email}`} class="hover:text-white transition">{businessInfo.email}</a></li>
            <li>Phone: {businessInfo.phone}</li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Legal</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacy" class="hover:text-white transition">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-white transition">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800 mt-8 pt-8 text-sm text-center">
        <p>&copy; {new Date().getFullYear()} {businessInfo.name}. All rights reserved.</p>
        <p class="mt-2">Florida Notary Public - Commission #{businessInfo.credentials.commission}</p>
      </div>
    </div>
  </footer>

  <script>
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
