# GitHub Personal Access Token (fine-grained: Contents RW, Pull requests RW, Metadata R)
GITHUB_TOKEN=your_github_token_here

# Cloudflare API Token (Pages edit permission)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Stripe Keys (TEST mode - switch to live when ready)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Cloudflare Turnstile (get from Cloudflare dashboard)
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
